{
  "name": "project-quick-launch",
  "version": "1.0.0",
  "description": "Windows 一键启动项目助手：本地项目快速启动 + Git 仓库拉取",
  "main": "./out/main/index.js",
  "author": "cy",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "electron-vite build",
    "smoke": "electron-vite build && electron . --smoke",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.22.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "electron-vite": "^2.3.0",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^4.5.5"
  }
}
